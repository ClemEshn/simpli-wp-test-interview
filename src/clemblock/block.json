{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "clemblock/clemblock",
	"version": "0.1.0",
	"title": "Clement's block",
	"category": "text",
	"icon": "smiley",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "clemblock",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js",
	"attributes": {
		"text": {
			"type": "string",
			"default" : "Hello World"
		},
		"backgroundColor": {
			"type": "string",
			"default": "#"
		},
		"borderStyle": {
			"type": "string",
			"default": "1px solid black"
		}
	}

}